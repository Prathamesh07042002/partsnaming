# ============================================================
# Vision provider selection
# ============================================================
# Which vision provider to use.  Supported: gemini | none
# Changing between implemented providers only needs this + MODEL_NAME.
MODEL_PROVIDER=gemini

# Model identifier for the chosen provider.  Provider-specific.
#   gemini examples: gemini-2.0-flash, gemini-2.5-flash, gemini-1.5-pro
MODEL_NAME=gemini-2.0-flash

# API key for the chosen provider.  NEVER commit the real value.
GEMINI_API_KEY=

# ============================================================
# Extraction strategy
# ============================================================
# vector_first : PyMuPDF runs first; vision is invoked only when needed.
# vision_first : vision runs first; PyMuPDF enriches/validates.
# hybrid       : BOTH always run; merger combines (default, recommended).
EXTRACTION_MODE=hybrid

# ============================================================
# Vision source tuning
# ============================================================
# DPI at which PDF pages are rasterized before being sent to the model.
# 150 = cheap/fast, 200-250 = better small-detail recall on dense drawings.
VISION_DPI=150

# Per-request timeout for the vision provider, in seconds.
VISION_TIMEOUT=120

# Retry count for transient vision API failures.
VISION_MAX_RETRIES=2

# ============================================================
# Vector source tuning
# ============================================================
# Minimum number of native text spans for a PDF page to be considered
# "vector-usable".  Below this, vector_first mode will fall through to
# vision.  Hybrid mode ignores this threshold (both always run).
VECTOR_MIN_SPANS=10

# ============================================================
# Merger tuning
# ============================================================
# Two candidates are considered the same feature if their bbox centres
# are within this many page points AND their text similarity >= the
# threshold below.
MERGE_SPATIAL_RADIUS_PT=28
MERGE_TEXT_SIMILARITY=0.82

# ============================================================
# Logging
# ============================================================
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Folder (relative to project root) containing PDFs / images to process.
INPUT_DIR=sources